{
  "name": "mcp-server-doctor",
  "version": "1.0.0",
  "description": "CLI diagnostic and profiling tool for MCP servers — Lighthouse for MCP. Transport negotiation, latency profiling, auth verification, payload limits, timeout behavior, error compliance, and graded report cards.",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "mcp-server-doctor": "dist/src/cli.js",
    "doctor": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "keywords": [
    "mcp",
    "diagnostic",
    "profiling",
    "lighthouse",
    "cli",
    "latency",
    "auth",
    "transport",
    "report-card"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "npm run build && node --enable-source-maps dist/src/cli.js",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/sdk-metrics": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "chalk": "^5.3.0",
    "eventsource": "^3.0.0",
    "commander": "^13.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.5.0",
    "prettier": "^3.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/mcp-server-doctor.git"
  },
  "homepage": "https://github.com/reaatech/mcp-server-doctor#readme",
  "bugs": {
    "url": "https://github.com/reaatech/mcp-server-doctor/issues"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "skills"
  ]
}
